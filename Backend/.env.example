# Application
NODE_ENV=development
PORT=3000
APP_NAME=LUMORA Backend
APP_VERSION=0.1.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Authentication
# Replace with a cryptographically secure secret before production.
# Never commit real secrets to GitHub.
JWT_SECRET=replace_with_a_secure_random_secret

# CORS
# Use exact origins without trailing slashes.
# Separate multiple origins with commas if supported by the application configuration.
CORS_ORIGIN=http://localhost:3000

# Session configuration
SESSION_TOKEN_BYTES=32
SESSION_TTL_SECONDS=604800
SESSION_MAX_TOKEN_LENGTH=1024
SESSION_LAST_USED_UPDATE_INTERVAL_SECONDS=300

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
