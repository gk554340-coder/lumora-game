# Application
NODE_ENV=development
PORT=3000
APP_NAME=LUMORA Backend
APP_VERSION=0.1.0
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# CORS
# Use exact origins without trailing slashes.
# Separate multiple origins with commas.
CORS_ORIGIN=http://localhost:3000

# Reverse proxy
# Set to true only when running behind a trusted proxy or load balancer,
# so the real client IP is used for rate limiting.
TRUST_PROXY=false

# Session configuration
SESSION_TOKEN_BYTES=32
SESSION_TTL_SECONDS=604800
SESSION_MAX_TOKEN_LENGTH=1024
SESSION_LAST_USED_UPDATE_INTERVAL_SECONDS=300

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Stricter rate limit for register and login (optional)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_TIME_WINDOW_MS=60000

# Google Play payments (optional)
# Leave all three empty to run without payments. Set all three together
# or the server refuses to start.
# Package name of the Android app, for example com.yourstudio.lumora.
GOOGLE_PLAY_PACKAGE_NAME=
# Service account key from Google Cloud, as raw JSON or base64 of the
# JSON. Give that account access to the app in Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Random secret, at least 32 characters. Used to build the hidden
# account id sent to Google. Never change it after launch, or old
# purchases can no longer be matched to their players.
GOOGLE_PLAY_ACCOUNT_SECRET=
# Accept Google test purchases. Defaults to true outside production
# and false in production.
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=

# Admin access (optional)
# Leave empty to turn the admin endpoints off. If set, it must be at
# least 32 random characters. Sent as the "x-admin-key" header. Keep
# the admin endpoints off the public internet where possible.
ADMIN_API_KEY=
# Admin requests allowed per minute per client (optional, 1 to 10000).
ADMIN_RATE_LIMIT_MAX=20
