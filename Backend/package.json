
{
  "name": "lumora-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Secure backend services for the LUMORA mobile game",
  "type": "module",
  "main": "dist/index.js",
"scripts": {
  "dev": "prisma generate && tsx watch src/index.ts",
  "build": "prisma generate && tsc",
  "start": "node dist/index.js",
  "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && node --import tsx --test \"tests/**/*.test.ts\"",
  "prisma:generate": "prisma generate"
},
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
